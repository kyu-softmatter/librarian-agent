# Local clone cache of the three source repositories — never canonical
cache/

# Derived artefacts are not tracked. Tracking one invites hand-editing it, and a
# hand-edited derived file outliving its generator is the failure this project
# exists to catch (BD's knowledge/source/papers/INDEX.md). They are byte-
# reproducible from kb/ plus a commit SHA, so history gains nothing by holding
# them.
index/
*.sqlite
*.sqlite-shm
*.sqlite-wal
map/manifest.json
export/ms/*
export/bd/*
!export/*/.gitkeep

# Copyrighted originals never enter the repository (BD knowledge/raw convention).
# Only the in-git distillation is canonical; the original is fetched via source_url.
kb/07-sources/raw/*
!kb/07-sources/raw/.gitkeep

# Retrieval sessions store raw query text, and this repository is public.
# What someone was looking for is what they are about to do, and in a public repo
# deleting the file afterwards does not undo the disclosure (rt T-019).
#
# Settled 2026-09-15, PLAN.md 6.1 / FEEDBACK.md decision 6: **local only, and
# not provisionally.** A session accumulates automatically, no human reads one
# before it lands, and volume guarantees none ever will -- so the default has to
# be safety. `oracles/` and `findings/` are committed, because a promotion is
# human-approved already and that approval is the disclosure review.
#
# `librarian/publish.py` declares the same boundary in code and
# `tests/test_publish_gate.py` asserts this file agrees with it. Widening the
# pattern below to `kb/08-retrieval/*` stops committing the regression oracles,
# and that failure would surface as "the oracles never ran in CI", much later.
kb/08-retrieval/sessions/*
!kb/08-retrieval/sessions/.gitkeep

# Fixture corpus: copies of real entries used to validate the build (BUILD.md).
# Copies, not migration — they are discarded when MIGRATION.md Step 1 begins.
fixtures/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# OS
.DS_Store
