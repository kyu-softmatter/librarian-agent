{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m librarian.cli:*)",
      "Bash(python -m pytest:*)",
      "Bash(pytest:*)",
      "Bash(librarian:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(shasum:*)",
      "Bash(du:*)"
    ],
    "deny": [
      "Bash(python -m librarian.cli promote:*)",
      "Edit(./index/**)",
      "Edit(./cache/**)"
    ]
  }
}
